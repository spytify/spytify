# Copy to .env next to spytifyd (or in the working directory) and fill in.
# spytify never names a player in its source: you choose the process.

# Process name of the player to record. A comma list covers several
# packagings (for example a distro package, a Snap and a Flatpak).
SPYTIFY_TARGET_PROCESS=

# D-Bus name of the player's MPRIS interface.
# Default: org.mpris.MediaPlayer2.<process name, lowercase>
SPYTIFY_TARGET_MPRIS=

# macOS bundle id (milestone M5; unused by the Linux alpha).
SPYTIFY_TARGET_BUNDLE_ID=

# Optional command that starts the player when a session starts and it is
# not running. Tried five times, three seconds apart.
SPYTIFY_TARGET_LAUNCH=

# Optional overrides.
# SPYTIFY_CONFIG=~/.config/spytify/config.toml
# SPYTIFY_SOCKET=$XDG_RUNTIME_DIR/spytify.sock
# SPYTIFY_FFMPEG=/usr/bin/ffmpeg
