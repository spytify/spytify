// The version information and manifest of spytify-tap.exe, which
// scripts/build-windows.sh compiles with windres; -D gives spytify.rc's
// VERSION options. No icon: only the app has one, so it is the one to open
// in the folder. spytifyd.exe and spytify-cli.exe carry none: antivirus
// engines flagged spytifyd.exe with them (#830).
#include <winver.h>

1 24 "helper.manifest"

1 VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Spytify"
      VALUE "LegalCopyright", "MIT License, https://spytify.github.io/spytify/"
      VALUE "ProductName", "Spytify"
      VALUE "ProductVersion", VERSION
      VALUE "FileDescription", "Spytify capture helper"
      VALUE "FileVersion", VERSION
      VALUE "InternalName", "spytify-tap.exe"
      VALUE "OriginalFilename", "spytify-tap.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
